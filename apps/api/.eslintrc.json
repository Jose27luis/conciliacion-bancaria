{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": { "project": "./tsconfig.lint.json", "tsconfigRootDir": "." },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:@typescript-eslint/recommended-requiring-type-checking"
  ],
  "env": { "node": true },
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-non-null-assertion": "error",
    "@typescript-eslint/ban-ts-comment": ["error", { "ts-expect-error": true, "ts-ignore": true, "ts-nocheck": true }],
    "@typescript-eslint/no-unsafe-argument": "error",
    "@typescript-eslint/no-unsafe-assignment": "error",
    "@typescript-eslint/no-unsafe-call": "error",
    "@typescript-eslint/no-unsafe-member-access": "error",
    "@typescript-eslint/no-unsafe-return": "error",
    "@typescript-eslint/explicit-module-boundary-types": "error",
    "no-warning-comments": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../../*/domain/*", "../../*/application/*", "../../*/infrastructure/*", "../../*/presentation/*"],
            "message": "Importa otro módulo solo desde su index.ts."
          }
        ]
      }
    ]
  },
  "noInlineConfig": true,
  "reportUnusedDisableDirectives": true,
  "ignorePatterns": ["dist", "prisma/migrations"]
}
